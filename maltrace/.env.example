# maltrace environment file. Copy to `.env` and fill in what you need.
# `scripts/run.sh` sources this before launching the app.
#
# Everything here is optional — maltrace boots without any of these set,
# but the corresponding features stay disabled.

# ── AI analyst panel ──────────────────────────────────────────────────────
# Unlocks the in-app Claude side panel. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the default Claude model or token budget.
# MALTRACE_AI_MODEL=claude-opus-4-7
# MALTRACE_AI_MAX_TOKENS=4096

# ── Face-search backends ──────────────────────────────────────────────────
# Yandex needs no key. The rest are optional; missing keys fall back to
# scraping or demo modes (see sidecars/face-search/SETUP.md).
BING_VISUAL_SEARCH_KEY=
FACECHECK_API_KEY=
# PIMEYES_API_KEY=
# FACESEARCH_HTTP_PROXY=http://user:pass@host:port
# FACESEARCH_LOGLEVEL=INFO

# ── Path overrides ────────────────────────────────────────────────────────
# Only needed if the sibling checkouts aren't next to maltrace/.
# MALTRACE_SPIDERFOOT_PATH=/path/to/spiderfoot
# MALTRACE_CLAUDE_OSINT_PATH=/path/to/Claude-OSINT
# MALTRACE_PLUGIN_PATH=/path/to/extra/plugins:/another/path
