{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "maltrace",
  "version": "0.1.0",
  "identifier": "dev.maltrace.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "maltrace",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm", "msi", "nsis", "dmg", "app"],
    "category": "Utility",
    "shortDescription": "Open-source OSINT investigation app — a Maltego CE alternative.",
    "longDescription": "Drop entities on a canvas, run transforms (WHOIS, DNS, breach lookups, face search, Brazilian OSINT, …), pivot through the resulting graph. MIT-licensed and plugin-extensible.",
    "homepage": "https://github.com/",
    "publisher": "maltrace",
    "copyright": "Copyright (c) 2026 maltrace contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "python3"]
      }
    }
  }
}
